import turtle as turtle_module
import random

turtle_module.colormode(255)
tim = turtle_module.Turtle()
tim.penup()
tim.speed('fastest')
tim.hideturtle()

colour_list=[(240, 240, 237), (237, 231, 234), (231, 239, 234), (225, 232, 238), (237, 35, 108), (148, 27, 66), (239, 73, 35), (10, 145, 92), (223, 167, 47), (176, 158, 49), (28, 123, 188), (45, 190, 231), (80, 22, 76), (242, 220, 51), (126, 193, 79), (252, 224, 0), (177, 42, 98), (184, 70, 39), (52, 173, 105), (153, 27, 23), (205, 133, 166), (41, 170, 199), (10, 99, 52), (92, 8, 7), (239, 162, 196), (245, 166, 156), (159, 212, 180), (4, 78, 31), (140, 211, 226), (1, 68, 113)]
tim.setheading(225)
tim.forward(300)
tim.setheading(0)
numbers_of_dots = 100

for dot_count in range(1, numbers_of_dots + 1):
    tim.dot(20,random.choice(colour_list))
    tim.forward(50)

    if dot_count % 10 == 0:
        tim.setheading(90)
        tim.forward(50)
        tim.setheading(180)
        tim.forward(500)
        tim.setheading(0)
