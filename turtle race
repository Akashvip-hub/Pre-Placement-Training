import random
from turtle import Turtle, Screen


screen = Screen()
screen.setup(width=500, height=400)
user_bet=screen.textinput(title= "make a bet",prompt= "which colour you are going to bet")
colour=["red","blue","yellow","green","purple","pink"]
y_pos = [-70,-40,-10,20,50,80]
all_turtle = []

for turtle in range(0,6):
    new_turtle = Turtle(shape="turtle")
    new_turtle.penup()
    new_turtle.color(colour[turtle])
    new_turtle.goto(x=-230, y=y_pos[turtle])
    all_turtle.append(new_turtle)

if user_bet:
    is_race_on = True

while is_race_on :
    for turtle in all_turtle:
        if turtle.xcor()>220:
            is_race_on = False
            winner_colour = turtle.pencolor()
            if winner_colour==user_bet:
                print(f'You win! {winner_colour} is a winner')
            else:
                print(f'you lost! {winner_colour} is a winner')

        run = random.randint(0,10)
        turtle.forward(run)

screen.exitonclick()
